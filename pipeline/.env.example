# pipeline/.env.example — 이 파일을 pipeline/.env 로 복사한 뒤 값을 채우세요.
#
#   cp pipeline/.env.example pipeline/.env
#
# ⚠️ pipeline/.env 는 .gitignore 에 걸려 있어 커밋되지 않습니다. (확인됨)
# ⚠️ 실제 키를 채팅창·코드·커밋에 붙여넣지 마세요. 이 파일에만 넣습니다.
# ⚠️ GitHub Actions 에서는 이 파일이 아니라 저장소 Secrets 를 씁니다 (STEP 2-C).

# DART OpenAPI 인증키 — https://opendart.fss.or.kr 에서 무료 발급
DART_KEY=

# 공공데이터포털 서비스키 — https://www.data.go.kr "금융위원회_주식시세정보" 활용신청
# 포털이 Encoding/Decoding 두 가지를 주는데, 여기에는 **Decoding 키**를 넣으세요.
DATA_GO_KR_KEY=
